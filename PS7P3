total_bonus = 0.0  # initialize sum
f = open("employees.txt", "r")  # open file for reading
# prime read
name = f.readline().rstrip('\n')
while name != "":
    salary = float(f.readline().rstrip('\n'))  # read salary
    if salary >= 100000:
        rate = 0.20
    elif salary >= 50000:
        rate = 0.15
    else:
        rate = 0.10
    bonus = salary * rate
    total_bonus += bonus
    # display info
    print(f"{name}\tSalary: ${salary:,.2f}\tBonus: ${bonus:,.2f}")
    # get next data line
    name = f.readline().rstrip('\n')
f.close()
print(f"Total Bonuses Paid: ${total_bonus:,.2f}")
